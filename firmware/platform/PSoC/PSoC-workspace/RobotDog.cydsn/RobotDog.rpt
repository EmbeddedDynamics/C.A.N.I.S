        Total # of product terms : 3
        List of special equations: 
            Clock  = (Net_25) => Global
            Clock Enable: True
        Main Equation            : 3 pterms
        (
              !\CORDIC:ctrl_cordic_1\ * \CORDIC:ctrl_cordic_0\ * 
              !\CORDIC:state_3\ * \CORDIC:state_2\ * !\CORDIC:state_1\ * 
              \CORDIC:state_0\ * \CORDIC:shiftn_0\ * 
              \CORDIC:MODULE_1:g1:a0:xlt\
            + \CORDIC:ctrl_cordic_1\ * \CORDIC:shiftn_1\
            + \CORDIC:ctrl_cordic_0\ * !\CORDIC:state_3\ * \CORDIC:state_2\ * 
              !\CORDIC:state_1\ * !\CORDIC:state_0\ * \CORDIC:shiftn_1\
        );
        Output = \CORDIC:shiftn_1\ (fanout=4)

    MacroCell: Name=\CORDIC:shiftn_0\, Mode=(T-Register)
        Total # of inputs        : 8
        Total # of product terms : 3
        List of special equations: 
            Clock  = (Net_25) => Global
            Clock Enable: True
        Main Equation            : 3 pterms
        (
              !\CORDIC:ctrl_cordic_1\ * \CORDIC:ctrl_cordic_0\ * 
              !\CORDIC:state_3\ * \CORDIC:state_2\ * !\CORDIC:state_1\ * 
              \CORDIC:state_0\ * \CORDIC:MODULE_1:g1:a0:xlt\
            + \CORDIC:ctrl_cordic_1\ * \CORDIC:shiftn_0\
            + \CORDIC:ctrl_cordic_0\ * !\CORDIC:state_3\ * \CORDIC:state_2\ * 
              !\CORDIC:state_1\ * !\CORDIC:state_0\ * \CORDIC:shiftn_0\
        );
        Output = \CORDIC:shiftn_0\ (fanout=5)
    </CYPRESSTAG>
